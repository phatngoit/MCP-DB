{
  "name": "mcp-db-connect",
  "version": "0.1.16",
  "description": "Universal MCP server for readonly-first Oracle, Microsoft SQL Server, and MongoDB access.",
  "type": "module",
  "homepage": "https://github.com/phatngoit/MCP-DB#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phatngoit/MCP-DB.git"
  },
  "bugs": {
    "url": "https://github.com/phatngoit/MCP-DB/issues"
  },
  "bin": {
    "mcp-db-connect": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "examples",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,md,json,yml,yaml}\"",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oracle",
    "mssql",
    "mongodb",
    "database",
    "ai"
  ],
  "author": "phatngoit",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "mongodb": "^6.12.0",
    "mssql": "^11.0.1",
    "oracledb": "^6.7.2",
    "pino": "^9.5.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
